NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://fafa:replace-me@localhost:5432/fafa
# Use a dedicated mainnet Solana RPC URL. Never commit the actual value.
SOLANA_RPC_URL=
# Server-side Jupiter developer API key; optional while swaps are disabled.
JUPITER_API_KEY=
# Keep disabled until operator has completed the acceptance tests in README.
TRANSACTIONS_ENABLED=false
# Enables BABA-quoted bonding curves; also requires TRANSACTIONS_ENABLED=true.
STOCK_LAUNCHES_ENABLED=false
# Optional graduation target for new BABA curves (no creator liquidity deposit).
BABA_GRADUATION_TARGET=100
# Exact verified non-stock mints, comma-separated. SOL and USDC by default.
SWAP_MINT_ALLOWLIST=So11111111111111111111111111111111111111112,EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Optional: Google Cloud Translation Basic API key, server-only.
# Without it, curated English/Chinese ticker pairs still work.
GOOGLE_TRANSLATE_API_KEY=

# FAFA is the default quote for new launches. Existing pairs are unchanged.
FAFA_GRADUATION_TARGET=10000000
# Rewards remain disabled by the release gate even if this flag is set.
RED_ENVELOPE_ENABLED=false
RED_ENVELOPE_PROGRAM_ID=
RED_ENVELOPE_SNAPSHOT_AUTHORITY=
RED_ENVELOPE_PROGRAM_SHA256=
RED_ENVELOPE_LOOKUP_TABLE=
# Separate worker only: absolute path to its gas/VRF keypair file, never the key itself.
RED_ENVELOPE_KEEPER_KEYPAIR=

# Optional server-run rewards; worker setup: deployment/CUSTODIAL-REWARDS.md
RED_ENVELOPE_MODE=custodial-v1
# Keep false until the dedicated worker is configured and funded.
